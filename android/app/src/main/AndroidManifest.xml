<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_m00v13"
        android:label="M00V13"
        android:theme="@style/AppTheme">

        <activity android:name=".PlayerActivity" android:screenOrientation="landscape" />
        <activity android:name=".SourceSelectionActivity" android:screenOrientation="landscape" />
        <activity android:name=".DownloadsActivity" android:screenOrientation="landscape" />
        <activity android:name=".BrowseActivity" android:screenOrientation="landscape" />
        <activity android:name=".SearchActivity" android:screenOrientation="landscape" />
        <activity android:name=".ProfileActivity" android:screenOrientation="landscape" />
        <activity android:name=".DebridActivity" android:screenOrientation="landscape" />
        <activity android:name=".MetadataActivity" android:screenOrientation="landscape" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
